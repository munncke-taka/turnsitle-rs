# Copy to /etc/ts-gate.env and fill in. Then: sudo chmod 600 /etc/ts-gate.env
# Format: KEY=VALUE, one per line. No quotes, no spaces around "=".

# ---- Required -------------------------------------------------------------
TURNSTILE__SITEKEY=
TURNSTILE__SECRET=
# Must be longer than 43 characters: openssl rand -base64 32
CHECK_COOKIE__HMAC_KEY=

# ---- Recommended for nginx on this host -----------------------------------
# nginx snippets send the client IP in X-Real-IP (see temp/ts-gate-server.conf).
IP_HEADER=X-Real-IP
# Keep Secure=true behind TLS.
CHECK_COOKIE__SECURE=true

# ---- Optional (defaults shown) --------------------------------------------
#TURNSTILE__MAX_RETRIES=3
#CHECK_COOKIE__NAME=TS_STATUS
#CHECK_COOKIE__TTL=3600
#CHECK_COOKIE__BIND_IP=true
#ORIGINAL_URI_HEADER=X-Original-uri
#LISTEN_ADDRESS=127.0.0.1:9000
